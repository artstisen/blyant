<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The version of Blyant (also in DialogText.ApplicationVersion): the product version, and that of the
             assembly and the file. The product version is the version alone, without the commit .NET adds to it -->
        <Version>1.0.1</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <AssemblyVersion>1.0.1.0</AssemblyVersion>
        <FileVersion>1.0.1.0</FileVersion>
        <!-- No dependency on the ICU libraries of the system (needed for the self-contained Linux builds) -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- The icon of Blyant.exe (Windows): a pencil writing a cursor, 16 to 256 pixels. It is drawn by
             tools/icon.py. Only a build on Windows puts it in (elsewhere the program has the default icon) -->
        <ApplicationIcon>Blyant.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Blyant.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The translations of the texts (see Lang.cs) -->
        <EmbeddedResource Include="Lang\*.txt" LogicalName="Blyant.Lang.%(Filename).txt" />
        <!-- The built-in color schemes (see ColorScheme.BuiltIn) -->
        <EmbeddedResource Include="Schemes\*.txt" LogicalName="Blyant.Schemes.%(Filename).txt" />
        <!-- The other languages: files in the folder "lang" next to the program, which users can change -->
        <None Include="Lang\External\*.txt" Link="lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>

</Project>
